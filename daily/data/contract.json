{
  "schema_version": 2,
  "locales": ["zh-TW", "en"],
  "min_items": 6,
  "max_items": 14,
  "categories": ["news", "papers", "products", "writing", "tools", "engineering"],
  "issue_text_fields": ["title", "coverage", "editorial_note"],
  "item_text_limits": {"title":220,"summary":1600,"takeaway":900,"caveat":900},
  "summary_policy": {
    "effective_from": "2026-10-06",
    "locale": "zh-TW",
    "target_characters": 200,
    "min_characters": 180,
    "max_characters": 240,
    "counting": "unicode_codepoints_excluding_whitespace",
    "required_content": ["what happened", "key details", "why it matters"],
    "insufficient_evidence": "skip_story_without_padding"
  }
}
